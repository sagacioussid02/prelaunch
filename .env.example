# Copy to .env (which is gitignored) and fill in real values.
# Never commit a real .env — see .gitignore.

# Owner token gating "full" scans on POST /api/scan via the
# x-prelaunch-owner-token header. If unset, full mode is refused (fail closed).
PRELAUNCH_OWNER_TOKEN=

# Directory for the prototype JSON scan store. Defaults to ./.data
PRELAUNCH_DATA_DIR=

# Durable storage for scans and monitors (issue #3). When set (Neon
# Postgres), Postgres is authoritative and the JSON file store above is
# bypassed. When unset, the file store is used (local dev, self-test).
DATABASE_URL=

# Screenshot storage. When set, screenshots go to Vercel Blob (private),
# keyed shots/{scanId}-{name}.jpg. When unset, they are JPEG files under
# ./.data/shots. Independent of DATABASE_URL.
BLOB_READ_WRITE_TOKEN=

# Shared rate limits (issue #6). When both are set (Upstash Redis REST),
# the scan/monitor per-IP counters are shared across instances and fail
# closed if Redis errors. When unset, limits fall back to per-process
# in-memory windows (local dev, self-test).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL used for absolute links in reports (e.g. badge/Rescan links).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Self-test only: lets scripts/test-scan.ts scan its 127.0.0.1 fixture
# despite the SSRF guard. NEVER set this in a deployed environment.
# PRELAUNCH_ALLOW_LOOPBACK=1
