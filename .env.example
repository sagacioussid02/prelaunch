# Copy to .env (which is gitignored) and fill in real values.
# Never commit a real .env — see .gitignore.

# Owner token gating "full" scans on POST /api/scan via the
# x-prelaunch-owner-token header. If unset, full mode is refused (fail closed).
PRELAUNCH_OWNER_TOKEN=

# Directory for the prototype JSON scan store. Defaults to ./.data
PRELAUNCH_DATA_DIR=

# Public base URL used for absolute links in reports (e.g. badge/Rescan links).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Self-test only: lets scripts/test-scan.ts scan its 127.0.0.1 fixture
# despite the SSRF guard. NEVER set this in a deployed environment.
# PRELAUNCH_ALLOW_LOOPBACK=1
