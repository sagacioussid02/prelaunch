# Copy to .env (which is gitignored) and fill in real values.
# Never commit a real .env — see .gitignore.

# Owner token gating "full" scans on POST /api/scan via the
# x-prelaunch-owner-token header. If unset, full mode is refused (fail closed).
PRELAUNCH_OWNER_TOKEN=

# Directory for the prototype JSON scan store. Defaults to ./.data
PRELAUNCH_DATA_DIR=

# Durable storage for scans and monitors (issue #3). When set (Neon
# Postgres), Postgres is authoritative and the JSON file store above is
# bypassed. When unset, the file store is used (local dev, self-test).
DATABASE_URL=

# Screenshot storage. When set, screenshots go to Vercel Blob (private),
# keyed shots/{scanId}-{name}.jpg. When unset, they are JPEG files under
# ./.data/shots. Independent of DATABASE_URL.
BLOB_READ_WRITE_TOKEN=

# Shared rate limits (issue #6). When both are set (Upstash Redis REST),
# the scan/monitor per-IP counters are shared across instances and fail
# closed if Redis errors. When unset, limits fall back to per-process
# in-memory windows (local dev, self-test).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Regression email for monitors (monitoring v2). When both are set,
# monitor regression alerts are sent via Resend; when unset, alerts are
# recorded as "queued" in the notification store and nothing is sent.
RESEND_API_KEY=
NOTIFY_FROM=

# Scheduled monitor runner auth. Vercel Cron (daily, vercel.json) and the
# hourly GitHub Actions workflow (.github/workflows/run-monitors.yml, which
# reads it from the repo secret CRON_SECRET) send
# `Authorization: Bearer <CRON_SECRET>` to /api/cron/run-monitors and
# /api/cron/retention.
# When unset, the cron endpoint refuses every call (fail closed).
CRON_SECRET=

# Plan limits (step 5). Comma-separated emails granted the Pro plan
# (10 monitors, full mode, hourly checks) at monitor creation; every
# other email is on Free (1 monitor, passive, daily). Since step 6
# this is the FALLBACK: a stored Stripe subscription in a Pro status
# (lib/billing.ts) wins over this list; the list remains for manual
# grants and for runs without Stripe configured.
PRO_EMAILS=

# Billing (step 6, Stripe). All unset = billing off: checkout/portal
# return 503, the webhook refuses unsigned events, and plan lookup
# falls back to PRO_EMAILS above. Test mode first — no live keys
# until the paid-tier launch gate. The Pro price is created in the
# Stripe dashboard (suggested: $9/mo recurring); its id goes here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
# Public base URL for checkout/portal redirects (falls back to the
# request origin when unset).
APP_URL=

# Signs the short-lived "Run now" dashboard links for monitors (issue #6).
# When unset, no link is minted and manual runs need the monitor's deploy
# token (fail closed). Use a long random value, e.g. `openssl rand -hex 32`.
PRELAUNCH_LINK_SECRET=

# Keys the IP hash in the scan request log (issue #6). Set it in production:
# unkeyed hashes of IPv4 addresses are trivially reversible.
PRELAUNCH_IP_HASH_SALT=

# Optional: global cap on scans per hour across all callers (default 200).
# Per-IP (5/hr) and per-target-host (10/hr) limits are fixed in code.
# PRELAUNCH_GLOBAL_SCANS_PER_HOUR=200

# Public base URL used for absolute links in reports (e.g. badge/Rescan links).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Self-test only: lets scripts/test-scan.ts scan its 127.0.0.1 fixture
# despite the SSRF guard. NEVER set this in a deployed environment.
# PRELAUNCH_ALLOW_LOOPBACK=1
